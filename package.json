{
  "name": "gurukul-bhose",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/public-website/vite.config.js apps/public-website",
    "dev:public": "vite --config apps/public-website/vite.config.js apps/public-website",
    "dev:admin": "vite --config apps/admin-panel/vite.config.js apps/admin-panel",
    "dev:telecaller": "vite --config apps/telecaller-panel/vite.config.js apps/telecaller-panel",
    "build:public": "vite build --config apps/public-website/vite.config.js apps/public-website",
    "build:admin": "vite build --config apps/admin-panel/vite.config.js apps/admin-panel",
    "build:telecaller": "vite build --config apps/telecaller-panel/vite.config.js apps/telecaller-panel && node -e \"const fs=require('fs'); fs.cpSync('dist/admin/telecaller', 'dist/telecaller', {recursive:true, force:true});\"",
    "build": "npm run build:public && npm run build:admin && npm run build:telecaller",
    "preview:public": "vite preview --config apps/public-website/vite.config.js apps/public-website",
    "preview:admin": "vite preview --config apps/admin-panel/vite.config.js apps/admin-panel",
    "preview:telecaller": "vite preview --config apps/telecaller-panel/vite.config.js apps/telecaller-panel",
    "test": "node --test tests/auth-and-roles.test.js tests/app-separation.test.js tests/cms-phase4.test.js tests/lead-crm-phase5.test.js tests/call-followup-phase6.test.js tests/admin-crm-phase9.test.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "firebase": "^10.14.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^5.4.10"
  }
}
