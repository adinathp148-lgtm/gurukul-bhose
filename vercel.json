{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/super-admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/super-admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/telecaller",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/telecaller/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/register",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/cms",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/cms/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/leads",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/leads/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/enquiries",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/gurukul-logo.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/telecaller/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/telecaller/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/telecaller/gurukul-logo.png",
      "destination": "/gurukul-logo.png"
    },
    {
      "source": "/telecaller/favicon.(.*)",
      "destination": "/favicon.$1"
    },
    {
      "source": "/admin/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/admin/images/(.*)",
      "destination": "/images/$1"
    },
    {
      "source": "/admin/gurukul-logo.png",
      "destination": "/gurukul-logo.png"
    },
    {
      "source": "/admin/favicon.(.*)",
      "destination": "/favicon.$1"
    },
    {
      "source": "/telecaller",
      "destination": "/telecaller/index.html"
    },
    {
      "source": "/telecaller/(.*)",
      "destination": "/telecaller/index.html"
    },
    {
      "source": "/telecaller/:match*",
      "destination": "/telecaller/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/super-admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/super-admin/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/super-admin/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/login",
      "destination": "/admin/index.html"
    },
    {
      "source": "/register",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/admin/index.html"
    },
    {
      "source": "/cms",
      "destination": "/admin/index.html"
    },
    {
      "source": "/cms/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/cms/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/enquiries",
      "destination": "/admin/index.html"
    },
    {
      "source": "/leads",
      "destination": "/admin/index.html"
    },
    {
      "source": "/leads/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/leads/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/telecallers",
      "destination": "/admin/index.html"
    },
    {
      "source": "/telecallers/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/telecallers/:match*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admissions",
      "destination": "/admin/index.html"
    },
    {
      "source": "/follow-ups",
      "destination": "/admin/index.html"
    },
    {
      "source": "/campus-visits",
      "destination": "/admin/index.html"
    },
    {
      "source": "/visit-desk",
      "destination": "/admin/index.html"
    },
    {
      "source": "/visit-calendar",
      "destination": "/admin/index.html"
    },
    {
      "source": "/visit-settings",
      "destination": "/admin/index.html"
    },
    {
      "source": "/call-monitoring",
      "destination": "/admin/index.html"
    },
    {
      "source": "/telecaller-performance",
      "destination": "/admin/index.html"
    },
    {
      "source": "/parent-communication",
      "destination": "/admin/index.html"
    },
    {
      "source": "/meta-integration",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admins",
      "destination": "/admin/index.html"
    },
    {
      "source": "/users",
      "destination": "/admin/index.html"
    },
    {
      "source": "/reports",
      "destination": "/admin/index.html"
    },
    {
      "source": "/notifications",
      "destination": "/admin/index.html"
    },
    {
      "source": "/audit-logs",
      "destination": "/admin/index.html"
    },
    {
      "source": "/settings",
      "destination": "/admin/index.html"
    },
    {
      "source": "/profile",
      "destination": "/admin/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
